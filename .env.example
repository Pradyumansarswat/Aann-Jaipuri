# ---- Copy to .env (or run `npm run setup` which creates it with random secrets) ----
NODE_ENV=production
PORT=3000

# Public URL of the site (used for sitemap, canonical links, WhatsApp previews). No trailing slash.
SITE_URL=https://www.example.com

# Set to 1 when behind nginx / Cloudflare / Render / Railway etc. so rate-limits see real visitor IPs.
TRUST_PROXY=0

# REQUIRED. Long random string (>= 32 chars). Never commit or share it.
SESSION_SECRET=

# First admin account. Created only if no admin exists yet.
# After first start you can delete ADMIN_PASSWORD from this file.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# Storage (outside the public folder)
DATA_DIR=./data

# Optional: email notification for every new enquiry (secrets stay on the server)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=

# ---- Visitor analytics (optional, cookie-less) ----
# Plausible: ANALYTICS_PROVIDER=plausible  ANALYTICS_SRC=https://plausible.io/js/script.js  ANALYTICS_SITE=yourdomain.com
# Umami:     ANALYTICS_PROVIDER=umami      ANALYTICS_SRC=https://cloud.umami.is/script.js  ANALYTICS_SITE=<website-id>
ANALYTICS_PROVIDER=
ANALYTICS_SRC=
ANALYTICS_SITE=

# ---- Monitoring (optional) ----
# Error tracking: project DSN from sentry.io. Stays on the server.
SENTRY_DSN=
# Uptime heartbeat: the server pings this URL every few minutes (UptimeRobot heartbeat / Healthchecks.io).
HEARTBEAT_URL=
HEARTBEAT_MINUTES=5
